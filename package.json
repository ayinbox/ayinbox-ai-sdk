{
  "name": "@ayinbox/ai-sdk",
  "version": "0.1.0",
  "description": "AY Inbox tools for the Vercel AI SDK: every agent tool your AY Inbox credential allows, loaded from the API at runtime.",
  "license": "MIT",
  "author": "AY Inbox <team@ayinbox.com>",
  "homepage": "https://github.com/ayinbox/ayinbox-ai-sdk#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ayinbox/ayinbox-ai-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/ayinbox/ayinbox-ai-sdk/issues"
  },
  "keywords": [
    "ayinbox",
    "ai-sdk",
    "vercel-ai",
    "tools",
    "agents",
    "cold-email"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "prepare": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run typecheck && npm run build && npm test"
  },
  "peerDependencies": {
    "ai": "^6.0.0 || ^7.0.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "ai": "7.0.172",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "vitest": "3.2.7",
    "zod": "4.6.7"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
